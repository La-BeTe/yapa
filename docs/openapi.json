                      "unique_reference": "order-7f3a9c",
                      "source": {
                        "wallet_id": "01JBWALLETALICE0000000000A",
                        "amount": "400",
                        "currency": "USDx",
                        "scale": 2
                      },
                      "destination": {
                        "wallet_id": "01JBWALLETBOB000000000000B",
                        "amount": "4975",
                        "currency": "cGHS",
                        "scale": 2
                      },
                      "fx": {
                        "mid_rate": "12.5",
                        "effective_rate": "12.4375",
                        "spread_bps": 50,
                        "fee_amount": "25",
                        "rate_source": "live",
                        "rate_refreshed_at": "2026-10-30T12:00:00.000Z"
                      },
                      "failure": null,
                      "created_at": "2026-10-30T12:00:00.000Z",
                      "completed_at": "2026-10-30T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "TRANSACTION_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "error",
                    "message": "Transaction 01J... was not found",
                    "data": {
                      "code": "TRANSACTION_NOT_FOUND"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Get a transaction by id",
        "tags": [
          "transactions"
        ]
      }
    },
    "/v1/wallets/{id}/transactions": {
      "get": {
        "description": "Includes deposits, swaps and transfers sent and received. Filter by type and by currency (either side). Pass next_cursor as cursor to get the next page.",
        "operationId": "WalletTransactionsController_list",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "DEPOSIT",
                "SWAP",
                "TRANSFER"
              ]
            }
          },
          {
            "name": "currency",
            "required": false,
            "in": "query",
            "description": "Matches the source or destination currency",
            "schema": {
              "type": "string",
              "enum": [
                "cNGN",
                "cGHS",
                "cXAF",
                "USDx",
                "EURx"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "next_cursor from the previous page",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "success",
                    "message": "Transactions retrieved",
                    "data": {
                      "items": [
                        {
                          "id": "01JBTXN0000000000000000001",
                          "type": "TRANSFER",
                          "status": "COMPLETED",
                          "unique_reference": "order-7f3a9c",
                          "source": {
                            "wallet_id": "01JBWALLETALICE0000000000A",
                            "amount": "400",
                            "currency": "USDx",
                            "scale": 2
                          },
                          "destination": {
                            "wallet_id": "01JBWALLETBOB000000000000B",
                            "amount": "4975",
                            "currency": "cGHS",
                            "scale": 2
                          },
                          "fx": {
                            "mid_rate": "12.5",
                            "effective_rate": "12.4375",
                            "spread_bps": 50,
                            "fee_amount": "25",
                            "rate_source": "live",
                            "rate_refreshed_at": "2026-10-30T12:00:00.000Z"
                          },
                          "failure": null,
                          "created_at": "2026-10-30T12:00:00.000Z",
                          "completed_at": "2026-10-30T12:00:00.000Z",
                          "direction": "OUT"
                        }
                      ],
                      "next_cursor": null,
                      "limit": 20
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "WALLET_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "error",
                    "message": "Wallet 01J... was not found",
                    "data": {
                      "code": "WALLET_NOT_FOUND"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "List a wallet's transactions, newest first",
        "tags": [
          "wallets"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness of MongoDB, Redis and TigerBeetle",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "YAPA: YAPA Is Another Payment API",
    "description": "Multi-currency stablecoin wallet sandbox (cNGN, cGHS, cXAF, USDx, EURx).\n\nConventions:\n- every response is an envelope `{ status, message, data }`;\n- amounts are integer strings in minor units (cXAF has 0 decimals, the others 2);\n- field names are snake_case;\n- `POST /transactions` is idempotent on `unique_reference`;\n- every response carries an `X-Request-Id` header.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "admin-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-admin-key"
      }
    },
    "schemas": {
      "TriggerJobDto": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "Job payload"
          }
        }
      },
      "UpdateFxRateDto": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "string",
            "example": "0.95",
            "description": "Static rate: units of quote currency per one unit of base currency"
          },
          "spread_bps": {
            "type": "number",
            "example": 50,
            "minimum": 0,
            "maximum": 9999
          },
          "prefer_static": {
            "type": "boolean",
            "description": "Use the static rate instead of live rates for this pair"
          }
        }
      },
      "CreateWalletDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+2348031234567",
            "description": "International format (E.164), including the country code"
          }
        }
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPOSIT",
              "SWAP",
              "TRANSFER"
            ]
          },
          "unique_reference": {
            "type": "string",
            "example": "order-7f3a9c",
            "description": "Client-chosen idempotency key; globally unique. Retrying with the same value and body replays the original result."
          },
          "amount": {
            "type": "string",
            "example": "500000",
            "description": "Source amount as an integer string of minor units"
          },
          "currency": {
            "type": "string",
            "description": "DEPOSIT only: currency to deposit",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ]
          },
          "source_wallet_id": {
            "type": "string",
            "description": "SWAP and TRANSFER"
          },
          "destination_wallet_id": {
            "type": "string",
            "description": "DEPOSIT and TRANSFER"
          },
          "source_currency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "description": "SWAP and TRANSFER"
          },
          "destination_currency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "description": "SWAP and TRANSFER"
          }
        },
        "required": [
          "type",
          "unique_reference",
          "amount"
        ]
      }
    }
  }
}
